{
 "project": "incubator-kie-drools",
 "target": "org.drools,org.kie@10.2.0",
 "rootfs_prefix": "/home/claude/EmbedTrace/cache/maven_targets/incubator-kie-drools",
 "runs": {
  "syft": {
   "version": "1.42.4",
   "exit": 0,
   "seconds": 18,
   "valid": true,
   "command": "syft dir:<root> -q -o cyclonedx-json=syft.cdx.json",
   "stderr_tail": ""
  },
  "trivy": {
   "version": "0.76.1",
   "exit": 0,
   "seconds": 8,
   "valid": true,
   "command": "trivy rootfs --quiet --scanners vuln --format cyclonedx --output trivy.cdx.json <root>",
   "stderr_tail": ""
  },
  "cdxgen": {
   "version": "12.9.0",
   "exit": 0,
   "seconds": 141,
   "valid": true,
   "command": "cdxgen -t universal -r --no-install-deps -o cdxgen.cdx.json <root>",
   "stderr_tail": ""
  }
 }
}